{
  "opencollection": "1.0.0",
  "info": {
    "name": "Pangea Security Services AI Guard Redact API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Redact",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Redact text.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{service}.{csp}.{geo}.pangea.cloud/v1/redact",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Redact sensitive information from provided text."
        },
        {
          "info": {
            "name": "Redact structured data.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{service}.{csp}.{geo}.pangea.cloud/v1/redact_structured",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Redact sensitive information from structured data such as JSON."
        }
      ]
    }
  ],
  "bundled": true
}